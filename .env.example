# Jungo API base URL (server-only; the browser never calls Jungo directly).
JUNGO_API_URL=http://localhost:8080
# JUNGO_TIMEOUT_MS=10000

# Cookies get Secure + __Host- prefix. Defaults to true in production.
# COOKIE_SECURE=false

# Set true only when Junext sits behind a reverse proxy you control (nginx), so X-Forwarded-For is trusted.
# Jungo must then list this server in SECURITY_TRUSTED_PROXIES.
# TRUST_PROXY_HEADERS=false

# DEFAULT_LOCALE=en
# DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh
